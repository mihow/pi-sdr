# sdrscan radio scanner, run as one container. Install with install.sh.
#
# The unit has no audio-device access and no ordering against the ambient player, the
# phone tunnel or the remote-access units. It only needs Docker. Resource limits are set on
# the container (docker run flags), because the container's processes live in Docker's
# cgroup, not this unit's. A hung USB read is caught by the scanner's own 120 s progress
# watchdog, which exits the process so Restart=always starts it again.

[Unit]
Description=sdrscan unattended radio scanner (container)
Requires=docker.service
After=docker.service
# The legacy OpenWebRX container also holds the dongle.
Conflicts=openwebrx.service
StartLimitIntervalSec=0

[Service]
Type=simple
EnvironmentFile=/etc/sdrscan/docker.env
Nice=10
IOSchedulingClass=idle
TimeoutStartSec=300
Restart=always
RestartSec=15
ExecStartPre=-/usr/bin/docker rm -f sdrscan
ExecStart=/usr/bin/docker run --rm --name sdrscan \
  --device /dev/bus/usb --group-add ${SDRSCAN_USB_GID} \
  --read-only --tmpfs /run/sdrscan:size=64m --tmpfs /tmp:size=16m \
  -v sdrscan-data:/var/lib/sdrscan -v /etc/sdrscan:/etc/sdrscan:ro \
  --network host \
  --cpus 2 --cpu-shares 512 --memory 1g --memory-swap 1g \
  --log-opt max-size=5m --log-opt max-file=2 \
  sdrscan:current
ExecStop=/usr/bin/docker stop -t 30 sdrscan

[Install]
WantedBy=multi-user.target
