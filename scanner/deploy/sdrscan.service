# sdrscan radio scanner, run as one container. Install with install.sh.
#
# The unit has no audio-device access and no ordering against the phone tunnel or the
# remote-access units. It only needs Docker. Resource limits are set on
# the container (docker run flags), because the container's processes live in Docker's
# cgroup, not this unit's (Nice= or IOSchedulingClass= here would apply only to the docker
# client). Inside the container, speech-to-text and the prose model run at nice 19.
# --blkio-weight takes effect only where the disk uses the BFQ I/O scheduler. A hung USB
# read is caught by the scanner's own 120 s progress watchdog, which exits the process so Restart=always starts it again.
#
# The container is started by /usr/local/lib/sdrscan/sdrscan-run, which passes only the
# dongle's own USB node (--device), never the whole /dev/bus/usb tree: other devices on the
# bus must stay out of reach of libusb in the container. A replugged or reset dongle gets a
# new node; the scanner exits with code 71 at the first reopen that reports the node gone
# (about 5 s, then systemd restarts 15 s later),
# and systemd restarts the wrapper, which finds the new node. The docker run flags and
# resource limits live in that wrapper.

[Unit]
Description=sdrscan unattended radio scanner (container)
Requires=docker.service
After=docker.service
# The legacy OpenWebRX container also holds the dongle.
Conflicts=openwebrx.service
StartLimitIntervalSec=0

[Service]
Type=simple
EnvironmentFile=/etc/sdrscan/docker.env
TimeoutStartSec=300
Restart=always
RestartSec=15
ExecStartPre=-/usr/bin/docker rm -f sdrscan
ExecStart=/usr/local/lib/sdrscan/sdrscan-run
ExecStop=/usr/bin/docker stop -t 30 sdrscan

[Install]
WantedBy=multi-user.target
